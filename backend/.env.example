# BuyPal backend environment template.
# Copy to .env and fill in real values. Never commit .env.

# Required.
NODE_ENV=development
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/buypal?retryWrites=true&w=majority
# Exact frontend origin(s), comma separated. The first entry is canonical
# (password-reset links and PayPal return URLs). No trailing slash.
FRONTEND_ORIGIN=http://localhost:5173

# Optional server settings.
PORT=4000
COOKIE_NAME=buypal_session
SESSION_TTL_DAYS=7
# lax | strict | none. Defaults to none in production (required when the
# frontend and API are on different sites, e.g. Vercel + Render) and lax otherwise.
# COOKIE_SAMESITE=lax

# Optional: admin key for POST /api/v1/wallet/admin/credit. Long random string.
WALLET_ADMIN_KEY=

# Optional: Gmail SMTP for password-reset email. Leave empty to disable email.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_APP_PASSWORD=
MAIL_FROM=

# PayPal. Sandbox values are safe to develop with; never commit live credentials.
PAYPAL_MODE=sandbox
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_CURRENCY=USD
