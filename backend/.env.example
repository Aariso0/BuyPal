NODE_ENV=development
PORT=4000
FRONTEND_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/buypal?retryWrites=true&w=majority
SESSION_TTL_DAYS=7
COOKIE_NAME=buypal_session

# Gmail SMTP (same Nodemailer + Gmail App Password approach used for Nivaran)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-gmail-address@gmail.com
SMTP_APP_PASSWORD=your-16-character-google-app-password
MAIL_FROM=BuyPal <your-gmail-address@gmail.com>

# PayPal environment. Sandbox is the default; production must be explicitly enabled.
# Never commit .env or expose PAYPAL_CLIENT_SECRET to the frontend.
PAYPAL_MODE=sandbox
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# BuyPal demo wallet and PayPal checkout use USD only.
PAYPAL_CURRENCY=USD
# Optional: secret for trusted administrator-only sandbox credit grants (never expose in frontend)
WALLET_ADMIN_KEY=replace-with-a-long-random-secret

# AI shopping assistant (Python service in ../ai, see ../ai/README.md).
# The backend calls it server-side; the browser never sees these values.
AI_SERVICE_URL=http://127.0.0.1:8000
# Must match AI_SERVICE_TOKEN in ../ai/.env. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AI_SERVICE_TOKEN=
# How long to wait for the AI service per request (5000-120000 ms).
AI_REQUEST_TIMEOUT_MS=45000
