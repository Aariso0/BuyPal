# BuyPal frontend environment template.
# Copy to .env for local development. Vite inlines these values into the built
# bundle, so only put a public API URL here. Never put backend secrets here.

# Backend API base URL, including the /api/v1 prefix.
# Local:  http://localhost:4000/api/v1
# Vercel: https://your-backend-host/api/v1  (required for `npm run build`)
VITE_API_URL=http://localhost:4000/api/v1
