# BuyPal AI service (Python / FastAPI). Copy to ".env" in this folder. Never commit .env.

# Where the service listens. Keep 127.0.0.1: only the BuyPal Node backend should reach it.
AI_AGENT_HOST=127.0.0.1
AI_AGENT_PORT=8000

# Shared secret between the Node backend and this service. Use the SAME value in backend/.env.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
AI_SERVICE_TOKEN=

# Optional: comma-separated browser origins allowed to call this service directly (normally leave empty).
AI_CORS_ORIGINS=

# --- LLM providers: set at least ONE key ---
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# --- Live product catalogue (optional but recommended) ---
CHANNEL3_API_KEY=
CHANNEL3_BASE_URL=https://api.trychannel3.com/v1
